{
  "name": "dsh-step-token-usage",
  "version": "1.3.0",
  "description": "DSH Web GUI 插件：token 用量常显在每条助手回复上，点开可看该步逐次模型请求明细（含重试）、逐桶单价与小计，并给出该步与该轮的消耗金额（按每次请求发生时刻的峰谷价格动态计算）。默认精简显示，细节可在设置里打开。不改动官方包。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "tokens",
    "token-usage",
    "usage",
    "cache",
    "observability",
    "web-ui"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hana647929196/dsh-step-token-usage.git"
  },
  "bugs": {
    "url": "https://github.com/hana647929196/dsh-step-token-usage/issues"
  },
  "homepage": "https://github.com/hana647929196/dsh-step-token-usage#readme"
}
